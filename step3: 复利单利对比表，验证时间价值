# 复利 vs 单利 对比程序（Step 3：交互式 + 对比表）
# 复利公式：A = P × (1 + r)^t      （每年复利 1 次，利息滚入下一年本金）
# 单利公式：A = P × (1 + r × t)    （只有本金生息，利息不再产生利息）
# 其中 P 为本金，r 为年利率（小数），t 为存款年数


def read_number(prompt):
    """循环读取用户输入，直到输入内容可以转换为数字为止。"""
    while True:                                      # 一直循环，直到输入合法才 return
        raw = input(prompt).strip()                  # 读取一行输入并去掉首尾空白
        raw = raw.rstrip("%")                        # 兼容“5%”写法：去掉末尾的百分号
        try:
            return float(raw)                        # 尝试把输入转换为浮点数并返回
        except ValueError:
            print("输入无效，请输入数字！")            # 转换失败（如输入字母）时提示并重输


# —— 1. 输入本金 P：必须是大于 0 的数字 ——
while True:
    P = read_number("请输入本金（元）：")             # P：本金（Principal），单位：元
    if P <= 0:                                       # 本金为 0 或负数没有存款意义
        print("本金必须大于 0，请重新输入！")
    else:
        break

# —— 2. 输入年利率 r：小数形式（0.05 表示 5%），也兼容 5% 写法，不能为负 ——
while True:
    raw = input("请输入年利率（小数形式，如 0.05 表示 5%；也可直接输入 5%）：").strip()
    has_percent = raw.endswith("%")              # 判断用户是否用了百分号写法
    raw = raw.rstrip("%")                         # 去掉末尾百分号后再转数字
    try:
        r = float(raw)                            # r：年利率（小数），0.05 即 5%
    except ValueError:
        print("输入无效，请输入数字！")            # 非数字输入（如字母）提示并重输
        continue
    if has_percent:
        r = r / 100                               # 百分号写法换算：5% → 0.05
    if r < 0:                                     # 负利率属于非法输入，提示后要求重输
        print("利率不能为负，请重新输入！")
    else:
        break

# —— 3. 输出 10/20/30 年复利 vs 单利对比表 ——
years = (10, 20, 30)                               # 固定对比的三个年限

print()                                            # 空一行，把输入区与表格分开
print(f"本金 {P:,.2f} 元 ｜ 年利率 {r * 100:.2f}% ｜ 复利每年计息 1 次")
print("-" * 52)
# 表头按“显示宽度”手工补齐空格：中文占 2 格，数字/符号占 1 格
# 列宽：年限6 | 复利终值13 | 单利终值13 | 差额11，分隔符 " | " 占 3 格
print(" 年限  |  复利终值(元) |  单利终值(元) |    差额(元)")
print("-" * 52)

for t in years:                                    # 依次计算 10、20、30 年
    compound = P * (1 + r) ** t                    # 复利终值：本金 × (1+年利率)^年数
    simple = P * (1 + r * t)                       # 单利终值：本金 × (1+年利率×年数)
    diff = compound - simple                       # 差额：复利比单利多赚的部分（恒 ≥ 0）
    # 三列金额统一千分位 + 保留两位小数、右对齐，保证表格整齐
    print(f"第{t}年 | {compound:>13,.2f} | {simple:>13,.2f} | {diff:>11,.2f}")

print("-" * 52)
print("注：差额 = 复利终值 - 单利终值，时间越久复利优势越大。")

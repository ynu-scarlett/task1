# 复利计算程序（Step 1）
# 复利公式：A = P × (1 + r/n)^(n×t)
# 其中 A 为最终本息和，P 为本金，r 为年利率，n 为每年复利次数，t 为存款年数

P = 10000          # P：本金（Principal），单位：元，初始存入 10000 元

r = 0.05           # r：年利率（annual rate），5% 换算为小数即 0.05

n = 1              # n：每年复利次数，每年复利 1 次（按年计息）

t = 3              # t：存款时间，单位：年，存满 3 年

# (1 + r/n)：每个计息期的利率因子，即 1 元钱经过一期后变成 (1 + 一期利率)
# n × t：整个存期内的总计息期数，3 年 × 每年 1 次 = 3 期
# (1 + r/n) ** (n * t)：复利增长倍数，每期利息都会加入下一期本金继续生息
A = P * (1 + r / n) ** (n * t)

# 输出最终本息和，使用 :.2f 格式化为保留两位小数
print(f"最终本息和为：{A:.2f} 元")
